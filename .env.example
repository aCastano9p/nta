# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://nta:nta@127.0.0.1:55432/nta
TEST_DATABASE_URL=postgresql+psycopg://nta:nta@127.0.0.1:55432/nta_test

# SEC requires "<name> <email>"; the poller refuses to start without it.
SEC_USER_AGENT="Your Name you@example.com"

# Optional, free (openfigi.com/api): makes allowlist loads of hundreds of tickers take seconds, not minutes.
OPENFIGI_API_KEY=

# Alpaca market data (free plan, IEX feed). Data API only; no trading endpoint is ever configured.
ALPACA_KEY_ID=replace-me
ALPACA_SECRET=replace-me

# ---- Phase 1: nta agent only (never give these to nta risk) ----
ANTHROPIC_API_KEY=
LLM_DAILY_USD=5
# LLM_TRIAGE_MODEL=claude-haiku-5-5
# LLM_EXTRACT_MODEL=claude-sonnet-5-5

# ---- Phase 1: nta risk only (never give these to nta agent) ----
# Paper account T. Must be a different Alpaca paper account from ALPACA_KEY_ID above (account D).
ALPACA_TRADING_KEY_ID=replace-me
ALPACA_TRADING_SECRET=replace-me
# Signs orders and the policy hash. Generate with: openssl rand -hex 32
RISK_SIGNING_KEY=
